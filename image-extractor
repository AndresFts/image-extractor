#!/usr/bin/env python3

import argparse
import csv
import mimetypes
import sys
from itertools import count
from pathlib import Path
from urllib.parse import urljoin, urlparse

import requests
from bs4 import BeautifulSoup
from requests.utils import requote_uri


IMG_SELECTOR = (
    "img.imageWithDefault-module__image___l4XCi.profile-logo-module__logoImage___pjwzX"
)


def read_csv_rows(path: Path):
    with path.open("r", encoding="utf-8", newline="") as f:
        reader = csv.DictReader(f)
        if reader.fieldnames is None:
            raise ValueError("CSV has no header row")
        headers = [h.strip() for h in reader.fieldnames]
        if headers != ["Channel", "URL"]:
            raise ValueError(
                "Spreadsheet must have exactly two columns: 'Channel' and 'URL'"
            )
        rows = []
        for row in reader:
            ch = (row.get("Channel") or "").strip()
            url = (row.get("URL") or "").strip()
            if url:
                rows.append((ch, url))
        return rows


def read_ods_rows(path: Path):
    try:
        from pyexcel_ods3 import get_data as get_ods_data
    except Exception as e:
        raise RuntimeError(
            "pyexcel-ods3 is required for .ods files (pip install pyexcel-ods3)"
        ) from e
    data = get_ods_data(str(path))
    if not data:
        raise ValueError("ODS file appears to be empty")
    sheet = next(iter(data.values()))
    if not sheet or not isinstance(sheet, list) or not sheet[0]:
        raise ValueError("ODS file has no header row")
    header = [str(h).strip() for h in sheet[0]]
    if header != ["Channel", "URL"]:
        raise ValueError(
            "Spreadsheet must have exactly two columns: 'Channel' and 'URL'"
        )
    rows = []
    for raw in sheet[1:]:
        cells = (raw + ["", ""])[:2]
        ch = str(cells[0]).strip()
        url = str(cells[1]).strip()
        if url:
            rows.append((ch, url))
    return rows


def read_rows(path: Path):
    ext = path.suffix.lower()
    if ext == ".csv":
        return read_csv_rows(path)
    if ext == ".ods":
        return read_ods_rows(path)
    raise ValueError("Only .csv and .ods files are supported")


def next_output_dir(base: str = "extracted-images") -> Path:
    for i in count(0):
        name = base if i == 0 else f"{base}-{i}"
        p = Path(name)
        if not p.exists():
            p.mkdir(parents=True, exist_ok=False)
            return p
    raise RuntimeError("Could not allocate output directory")


def infer_ext(img_url: str, content_type: str | None) -> str:
    if content_type:
        ct = content_type.split(";")[0].strip().lower()
        ext = mimetypes.guess_extension(ct)
        if ext:
            return ext
        if ct == "image/jpg":
            return ".jpg"
    ext = Path(urlparse(img_url).path).suffix
    if ext.lower() in {".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg"}:
        return ext
    return ".jpg"


def fetch_logo_src(page_url: str, session: requests.Session) -> str | None:
    # Normalize URL to handle non-ASCII characters and mixed encoding
    normalized_url = requote_uri(page_url)
    headers = {
        "User-Agent": (
            "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
            "(KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
        )
    }
    r = session.get(normalized_url, headers=headers, timeout=20)
    r.raise_for_status()
    soup = BeautifulSoup(r.text, "html.parser")
    img = soup.select_one(IMG_SELECTOR)
    if not img:
        return None
    src = img.get("src") or img.get("data-src") or img.get("data-original")
    if not src:
        return None
    # Join against the normalized page URL, then requote again to be safe
    return requote_uri(urljoin(normalized_url, src))


def download_image(img_url: str, out_dir: Path, base_name: str, session: requests.Session) -> Path | None:
    # Normalize image URL as well to avoid issues with special characters
    normalized_img_url = requote_uri(img_url)
    headers = {
        "User-Agent": (
            "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
            "(KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
        )
    }
    r = session.get(normalized_img_url, headers=headers, timeout=30, stream=True)
    r.raise_for_status()
    ext = infer_ext(normalized_img_url, r.headers.get("Content-Type"))
    for i in count(0):
        suffix = "" if i == 0 else f"-{i}"
        fname = f"{base_name}{suffix}{ext}"
        out_path = out_dir / fname
        if not out_path.exists():
            with out_path.open("wb") as fp:
                for chunk in r.iter_content(chunk_size=8192):
                    if chunk:
                        fp.write(chunk)
            return out_path
    return None


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(
        prog="image-extractor",
        description="Read a .csv or .ods (Channel, URL) and download logo images.",
    )
    parser.add_argument("spreadsheet", type=str, help="Path to .csv or .ods file")
    args = parser.parse_args(argv)

    path = Path(args.spreadsheet).expanduser().resolve()
    if not path.exists() or not path.is_file():
        print(f"Error: file not found: {path}", file=sys.stderr)
        return 2

    try:
        rows = read_rows(path)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        return 1

    out_dir = next_output_dir("extracted-images")
    session = requests.Session()

    for idx, (_channel, url) in enumerate(rows, start=1):
        base = f"{idx:03d}"
        try:
            logo_src = fetch_logo_src(url, session)
            if not logo_src:
                print(f"[{idx}] No matching logo found for URL: {url}")
                continue
            saved = download_image(logo_src, out_dir, base, session)
            if saved:
                print(f"[{idx}] Saved {saved.name}")
            else:
                print(f"[{idx}] Failed to save image for URL: {url}")
        except requests.HTTPError as e:
            status = e.response.status_code if e.response else "HTTP error"
            print(f"[{idx}] HTTP error for {url}: {status}", file=sys.stderr)
        except requests.exceptions.TooManyRedirects:
            print(
                f"[{idx}] Skipping {url} due to redirect loop (site keeps redirecting)",
                file=sys.stderr,
            )
        except requests.RequestException as e:
            print(f"[{idx}] Network error for {url}: {e}", file=sys.stderr)
        except Exception as e:
            print(f"[{idx}] Unexpected error for {url}: {e}", file=sys.stderr)

    print("finished.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
